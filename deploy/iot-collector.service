[Unit]
Description=IoT Data Collector
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=iot-collector
Group=iot-collector
SupplementaryGroups=dialout
EnvironmentFile=-/etc/iot-collector/influxdb.env
ExecStart=/usr/local/bin/iot-collector /etc/iot-collector/config.yaml
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM
StateDirectory=iot-collector
StateDirectoryMode=0750
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/iot-collector
StandardOutput=journal
StandardError=journal
SyslogIdentifier=iot-collector

[Install]
WantedBy=multi-user.target
